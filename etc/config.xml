<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <angeo_ai_description>
            <general>
                <enabled>0</enabled>
                <dry_run>1</dry_run>
                <log_enabled>1</log_enabled>
                <batch_size>50</batch_size>
            </general>
            <ai_provider>
                <provider>openai</provider>
            </ai_provider>
            <openai>
                <model>gpt-4.1</model>
                <temperature>0.7</temperature>
                <max_tokens>800</max_tokens>
                <timeout>30</timeout>
            </openai>
            <claude>
                <model>claude-sonnet-4-6</model>
                <max_tokens>1024</max_tokens>
                <timeout>60</timeout>
                <extended_thinking>0</extended_thinking>
                <thinking_budget>2048</thinking_budget>
            </claude>
            <gemini>
                <model>gemini-2.5-flash-preview-05-20</model>
                <temperature>0.7</temperature>
                <max_tokens>1024</max_tokens>
                <timeout>30</timeout>
            </gemini>
            <groq>
                <model>llama-3.3-70b-versatile</model>
                <temperature>0.7</temperature>
                <max_tokens>1024</max_tokens>
                <timeout>30</timeout>
            </groq>
            <prompt>
                <system_role>You are a professional product copywriter specialising in e-commerce.</system_role>
                <prompt_template>Write a professional and SEO-friendly product description for "{{product_name}}". Include key benefits, features, and use cases. Format using HTML paragraphs.</prompt_template>
                <language>en</language>
                <include_seo>1</include_seo>
            </prompt>
            <attributes>
                <description_enabled>1</description_enabled>
                <short_description_enabled>1</short_description_enabled>
                <short_description_length>150</short_description_length>
                <meta_title_enabled>0</meta_title_enabled>
                <meta_keyword_enabled>0</meta_keyword_enabled>
                <meta_description_enabled>0</meta_description_enabled>
            </attributes>
            <google_sheets>
                <enabled>0</enabled>
                <gid>0</gid>
                <sku_column_index>0</sku_column_index>
            </google_sheets>
            <export>
                <csv_enabled>1</csv_enabled>
                <csv_filename>ai_descriptions_{{date}}.csv</csv_filename>
            </export>
            <google_drive>
                <enabled>0</enabled>
                <sheet_name>Sheet1</sheet_name>
                <overwrite_existing>0</overwrite_existing>
            </google_drive>
            <cron>
                <enabled>0</enabled>
                <schedule>0 2 * * *</schedule>
            </cron>
        </angeo_ai_description>
    </default>
</config>
